# Copy this file to .env.jira (already gitignored) and fill in your real values.
# Never commit .env.jira — it holds a live API token.

# Your JIRA site, e.g. https://yourcompany.atlassian.net
JIRA_SITE_URL=

# The email address you log into JIRA with
JIRA_EMAIL=

# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# The project key tickets should be created under, e.g. FE for "Frontend"
JIRA_PROJECT_KEY=
