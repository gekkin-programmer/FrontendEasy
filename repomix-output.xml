      {/* Main Card */}
      <HardCard className="p-6 md:p-8 z-10 min-h-[360px] bg-white overflow-hidden" rivets={true}>
        
        {/* Raw Data Stream */}
        <div className="absolute top-2 right-2 font-mono text-[8px] text-black/30 leading-tight pointer-events-none text-right">
