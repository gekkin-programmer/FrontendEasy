  },
  messages: [
    {
      id: 1,
      sender: 'customer',
      content: "This is amazing! I've been waiting for an AI scheduling feature. Quick question - does it work with TikTok as well?",
      timestamp: '1h 45m ago',
    },
    {
      id: 2,
      sender: 'team',
