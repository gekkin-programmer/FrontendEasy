  // Typewriter Effect
  useEffect(() => {
    const currentText = textsToType[currentIndex];
    const fullText = t(currentText.en, currentText.fr);

    const type = () => {
      if (!isDeleting && prompt.length < fullText.length) {
        setPrompt(fullText.slice(0, prompt.length + 1));
