# =================================
# DATABASE
# =================================
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# =================================
# JWT
# =================================
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRATION="7d"
REFRESH_TOKEN_SECRET="your-refresh-secret-here"
REFRESH_TOKEN_EXPIRATION="30d"

# =================================
# APPLICATION
# =================================
NODE_ENV="development"
API_PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
FRONTEND_NEXT_URL="http://localhost:3001"

# =================================
# REDIS (BullMQ job queues)
# =================================
REDIS_HOST="redis"       # Use "redis" in Docker Compose, "localhost" for local dev
REDIS_PORT=6379
REDIS_PASSWORD=""        # Leave empty unless your Redis requires auth

# =================================
# OAUTH — Google
# =================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-secret"
# Must match exactly what is registered in Google Cloud Console → Credentials → Authorized redirect URIs
GOOGLE_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/auth/google/redirect"
# For local dev use: http://localhost:3000/api/auth/google/redirect

# =================================
# CLOUDINARY (Optional)
# =================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# =================================
# EMAIL (Optional)
# =================================
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"

# =================================
# AI (Optional)
# =================================
OPENAI_API_KEY="sk-..."

# =================================
# PAYMENTS — PawaPay
# =================================
PAWAPAY_BASE_URL="https://api.pawapay.io"
# For sandbox use: https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN="your-pawapay-api-token"
PAWAPAY_WEBHOOK_SECRET="your-pawapay-webhook-secret"

# Stripe (card payments)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# =================================
# TELEGRAM BOT
# =================================
TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
# Set this in production to receive webhook updates (recommended over polling)
# Must be HTTPS. After deploy, call GET /telegram/setup-webhook once.
TELEGRAM_WEBHOOK_URL="https://backend-eazypost.mbokofit.com/api/telegram/webhook"

# =================================
# SOCIAL OAUTH — Callback URLs
# These MUST match exactly what is registered in each platform's developer portal.
# For local dev with ngrok: register the ngrok URL in each portal, then set it here.
# For production: use the backend-eazypost.mbokofit.com URL below.
# =================================

# Facebook / Instagram / WhatsApp (all share one app)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/facebook"
# Local dev: FACEBOOK_CALLBACK_URL="https://<your-ngrok>.ngrok-free.dev/api/social-accounts/callback/facebook"

# Twitter / X
TWITTER_API_KEY="your-twitter-api-key"
TWITTER_API_SECRET="your-twitter-api-secret"
TWITTER_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/twitter"
# Local dev: TWITTER_CALLBACK_URL="https://<your-ngrok>.ngrok-free.dev/api/social-accounts/callback/twitter"

# LinkedIn
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/linkedin"
# Local dev: LINKEDIN_CALLBACK_URL="https://<your-ngrok>.ngrok-free.dev/api/social-accounts/callback/linkedin"

# TikTok
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/tiktok"
# Local dev: TIKTOK_CALLBACK_URL="https://<your-ngrok>.ngrok-free.dev/api/social-accounts/callback/tiktok"

# YouTube (Google OAuth — separate app or same as Google auth)
YOUTUBE_CLIENT_ID="your-youtube-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
YOUTUBE_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/youtube"
# Local dev: YOUTUBE_CALLBACK_URL="https://<your-ngrok>.ngrok-free.dev/api/social-accounts/callback/youtube"

# Snapchat
SNAPCHAT_CLIENT_ID="your-snapchat-client-id"
SNAPCHAT_CLIENT_SECRET="your-snapchat-client-secret"
SNAPCHAT_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/snapchat"

# Pinterest
PINTEREST_APP_ID="your-pinterest-app-id"
PINTEREST_APP_SECRET="your-pinterest-app-secret"
PINTEREST_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/pinterest"

# Discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_CALLBACK_URL="https://backend-eazypost.mbokofit.com/api/social-accounts/callback/discord"

# =================================
# MONITORING
# =================================
SENTRY_DSN="https://...@...ingest.sentry.io/..."
