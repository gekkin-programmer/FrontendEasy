<!-- src/common/providers/email/templates/invite.hbs -->
<div style="font-family: Arial, sans-serif; padding: 20px; color: #333;">
  <h2 style="color: #007bff;">Hello! Welcome to EasyPost</h2>
  <p>
    You have been invited to join the workspace <strong>{{ workspaceName }}</strong> on EasyPost.
  </p>
  <p>
    Click the button below to accept the invitation and start collaborating.
  </p>
  <a href="{{ url }}" 
     style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 20px 0;">
    Join Workspace
  </a>
  <p style="font-size: 12px; color: #777;">
    If you did not expect this invitation, you can ignore this email.
  </p>
</div>